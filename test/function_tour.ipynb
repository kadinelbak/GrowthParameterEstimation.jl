     "# Fitting + comparisons\n",
     "fit = run_single_fit(x, y, p0; model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), solver=Tsit5(), bounds=bounds, show_stats=false)\n",
     "comp = compare_models(x, y, \"Logistic\", GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), [0.2, 12.0], \"Gompertz\", GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_gompertz()), [0.2, 1.2, 12.0]; solver=Tsit5(), bounds1=bounds, bounds2=[(0.01, 2.0), (0.1, 5.0), (2.0, 100.0)], show_stats=false, output_csv=joinpath(tempdir(), \"nb_compare.csv\"))\n",
     "\n",
     "specs = Dict(\"Logistic\" => (model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), p0=[0.2, 12.0], bounds=bounds), \"Exp\" => (model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_exponential()), p0=[0.2], bounds=[(0.001, 2.0)]))\n",
     "_ = compare_models_dict(x, y, specs; default_solver=Tsit5(), show_stats=false, output_csv=joinpath(tempdir(), \"nb_compare_dict.csv\"))\n",
     "println(\"Fit params: \", fit.params, \" | Best model: \", comp.best_model.name)"
    ]
