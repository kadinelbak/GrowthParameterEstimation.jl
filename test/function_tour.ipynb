     "# Analysis\n",
     "loo = leave_one_out_validation(x, y, [0.2, 12.0]; model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), solver=Tsit5(), bounds=bounds, show_stats=false)\n",
     "kfold = k_fold_cross_validation(x, y, [0.2, 12.0]; k_folds=3, model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), solver=Tsit5(), bounds=bounds, show_stats=false)\n",
     "sens = parameter_sensitivity_analysis(x, y, fit; perturbation=0.1, model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), solver=Tsit5())\n",
     "resid = residual_analysis(x, y, fit; model=GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), solver=Tsit5())\n",
     "enh = enhanced_bic_analysis(x, y; models=[GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_logistic()), GrowthParameterEstimation.Models.to_ode!(GrowthParameterEstimation.Models.build_gompertz())], model_names=[\"Logistic\", \"Gompertz\"], p0_values=[[0.2, 12.0], [0.2, 1.2, 12.0]], solver=Tsit5())\n",
     "println(\"LOO RMSE: \", loo.rmse, \" | k-fold RMSE: \", kfold.overall_rmse, \" | Best enhanced BIC model: \", enh.best_model.model_name)"
    ]
