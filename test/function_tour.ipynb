    "source": [
     "# Set up staged pipeline with parameter inheritance\n",
     "using GrowthParameterEstimation\n",
     "\n",
     "# Define the stages of our pipeline\n",
     "stages = [\n",
     "    # Stage 1: Fit monoculture untreated to establish baseline growth parameters\n",
     "    PipelineStage(\n",
     "        \"monoculture_untreated\",\n",
     "        \"Estimate baseline growth parameters from untreated monoculture\",\n",
     "        row -> row[:culture_type] == \"monoculture\" && row[:dose] == 0.0,\n",
     "        [:cell_line, :population_type, :replicate],\n",
     "        [\"logistic_growth\"],  # Only test logistic growth for simplicity\n",
     "        Symbol[],              # No parameters to inherit for first stage\n",
     "        Dict{Symbol,Float64}(), # No fixed parameters\n",
     "        Dict{Symbol,Tuple{String,Symbol}}()  # No parameter inheritance\n",
     "    ),\n",
     "\n",
     "    # Stage 2: Fit monoculture treated, inheriting growth parameters from Stage 1\n",
     "    PipelineStage(\n",
     "        \"monoculture_treated\",\n",
     "        \"Estimate drug death rate while inheriting growth parameters\",\n",
     "        row -> row[:culture_type] == \"monoculture\" && row[:dose] > 0.0,\n",
     "        [:dose, :cell_line, :population_type, :replicate],\n",
     "        [\"logistic_growth_with_death\"],  # Model with death term\n",
     "        [:death_rate],                    # Parameters to estimate in this stage\n",
     "        Dict(:r => 1.0, :K => 1.0),       # Fixed parameters (will be overridden by inheritance)\n",
     "        Dict(\n",
     "            :r => (\"monoculture_untreated\", :r),      # Inherit growth rate\n",
     "            :K => (\"monoculture_untreated\", :K)       # Inherit carrying capacity\n",
     "        )\n",
     "    ),\n",
     "\n",
     "    # Stage 3: Fit coculture untreated, inheriting growth parameters, estimating interaction\n",
     "    PipelineStage(\n",
     "        \"coculture_untreated\",\n",
     "        \"Estimate interaction parameters while inheriting growth parameters\",\n",
     "        row -> row[:culture_type] == \"coculture\" && row[:dose] == 0.0,\n",
     "        [:cell_line, :population_type, :replicate],\n",
     "        [\"logistic_growth\"],  # Base model - we'll need to extend this for interaction\n",
     "        Symbol[],              # Parameters to estimate\n",
     "        Dict{Symbol,Float64}(), # Fixed parameters\n",
     "        Dict(\n",
     "            :r => (\"monoculture_untreated\", :r),      # Inherit growth rate\n",
     "            :K => (\"monoculture_untreated\", :K)       # Inherit carrying capacity\n",
     "        )\n",
     "    ),\n",
     "\n",
     "    # Stage 4: Fit coculture treated, inheriting all previous parameters\n",
     "    PipelineStage(\n",
     "        \"coculture_treated\",\n",
     "        \"Estimate combined drug and interaction effects\",\n",
     "        row -> row[:culture_type] == \"coculture\" && row[:dose] > 0.0,\n",
     "        [:dose, :cell_line, :population_type, :replicate],\n",
     "        [\"logistic_growth_with_death\"],  # Model with death term\n",
     "        [:death_rate],                    # Parameters to estimate\n",
     "        Dict{Symbol,Float64}(),           # Fixed parameters\n",
     "        Dict(\n",
     "            :r => (\"monoculture_untreated\", :r),      # Inherit growth rate\n",
     "            :K => (\"monoculture_untreated\", :K)       # Inherit carrying capacity\n",
     "        )\n",
     "    )\n",
     "]\n",
     "\n",
     "# Note: For simplicity in this example, we're using existing model types.\n",
     "# In a real implementation, we would need to register the interaction models.\n",
     "# This example focuses on demonstrating the parameter inheritance mechanism.\n",
     "\n",
     "# Create pipeline configuration\n",
     "cfg = default_config(output_dir = joinpath(tempdir(), \"staged_pipeline_example\"))\n",
     "\n",
     "println(\"Staged pipeline configuration created with \", length(stages), \" stages\")"
    ]
