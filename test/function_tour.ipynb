    "cell_type": "markdown",
    "id": "staged-pipeline-example",
    "metadata": {},
    "source": [
     "# Staged Pipeline Example: From Monoculture to Coculture\n",
     "\n",
     "This example demonstrates a complete staged pipeline workflow that starts with monoculture untreated data and progresses to treated coculture data, showcasing how parameters from earlier stages can be inherited by later stages.\n",
     "\n",
     "## Biological Context\n",
     "- **Stage 1**: Monoculture untreated - establishes baseline growth parameters\n",
     "- **Stage 2**: Monoculture treated - adds drug effect while inheriting growth parameters\n",
     "- **Stage 3**: Coculture untreated - adds population interaction while inheriting growth parameters\n",
     "- **Stage 4**: Coculture treated - combines drug and interaction effects while inheriting all previous parameters\n",
     "\n",
     "We'll generate synthetic data that follows recognizable biological growth models and add realistic noise."
    ]
   },
   {
    "cell_type": "code",
    "execution_count": 35,
    "id": "staged-data-generation",
    "metadata": {},
    "outputs": {},
    "source": [
     "# Generate synthetic data for staged pipeline example\n",
     "using Random, DataFrames\n",
     "\n",
     "Random.seed!(42)\n",
     "\n",
     "# Time points for experiments\n",
     "time_points = collect(0.0:0.5:10.0)\n",
     "n_timepoints = length(time_points)\n",
     "\n",
     "# True biological parameters\n",
     "true_r = 0.4          # growth rate\n",
     "true_K = 1e6          # carrying capacity\n",
     "true_death_rate = 0.25 # drug-induced death rate\n",
     "true_interaction = 0.3 # population interaction strength\n",
     "\n",
     "# Helper function for logistic growth with death\n",
     "function logistic_growth_with_death!(du, u, p, t, exposure)\n",
     "    r, K = p\n",
     "    N = max(u[1], 0.0)\n",
     "    C = max(exposure(t), 0.0)\n",
     "    death = true_death_rate * C * N  # linear death term\n",
     "    growth = r * N * (1.0 - N / true_K)\n",
     "    du[1] = growth - death\n",
     "end\n",
     "\n",
     "# Helper function for two-state logistic growth with interaction\n",
     "function two_state_logistic_interaction!(du, u, p, t)\n",
     "    r, K = p\n",
     "    N1 = max(u[1], 0.0)\n",
     "    N2 = max(u[2], 0.0)\n",
     "    # Logistic growth for each population\n",
     "    growth1 = r * N1 * (1.0 - N1 / true_K)\n",
     "    growth2 = r * N2 * (1.0 - N2 / true_K)\n",
     "    # Interaction term (competition)\n",
     "    interaction1 = -true_interaction * N1 * N2 / true_K\n",
     "    interaction2 = -true_interaction * N2 * N1 / true_K\n",
     "    du[1] = growth1 + interaction1\n",
     "    du[2] = growth2 + interaction2\n",
     "end\n",
     "\n",
     "# Helper function for two-state logistic growth with interaction and death\n",
     "function two_state_logistic_interaction_death!(du, u, p, t, exposure)\n",
     "    r, K = p\n",
     "    N1 = max(u[1], 0.0)\n",
     "    N2 = max(u[2], 0.0)\n",
     "    C = max(exposure(t), 0.0)\n",
     "    # Logistic growth for each population\n",
     "    growth1 = r * N1 * (1.0 - N1 / true_K)\n",
     "    growth2 = r * N2 * (1.0 - N2 / true_K)\n",
     "    # Death term (only affects population 1 for simplicity)\n",
     "    death = true_death_rate * C * N1\n",
     "    # Interaction term (competition)\n",
     "    interaction1 = -true_interaction * N1 * N2 / true_K\n",
     "    interaction2 = -true_interaction * N2 * N1 / true_K\n",
     "    du[1] = growth1 - death + interaction1\n",
     "    du[2] = growth2 + interaction2\n",
     "end\n",
     "\n",
     "# Generate data for each condition\n",
     "using OrdinaryDiffEq, DifferentialEquations\n",
     "\n",
     "# 1. Monoculture Untreated (baseline)\n",
     "prob_mono_untreated = ODEProblem(logistic_growth_with_death!, [1e4], (0.0, 10.0), [true_r, true_K])\n",
     "sol_mono_untreated = solve(prob_mono_untreated, Tsit5(), saveat=time_points)\n",
     "mono_untreated_counts = sol_mono_untreated.u .+ 50.0 .* randn(n_timepoints)  # Add noise\n",
     "mono_untreated_counts = max.(mono_untreated_counts, 100.0)  # Ensure positive counts\n",
     "\n",
     "# 2. Monoculture Treated (with drug)\n",
     "exposure_fn_mono_treated = t -> 0.8  # Constant drug exposure\n",
     "prob_mono_treated = ODEProblem(logistic_growth_with_death!, [1e4], (0.0, 10.0), [true_r, true_K];)\n",
     "sol_mono_treated = solve(prob_mono_treated, Tsit5(), saveat=time_points)\n",
     "mono_treated_counts = sol_mono_treated.u .+ 50.0 .* randn(n_timepoints)  # Add noise\n",
     "mono_treated_counts = max.(mono_treated_counts, 100.0)  # Ensure positive counts\n",
     "\n",
     "# 3. Coculture Untreated (two populations, no drug)\n",
     "prob_coculture_untreated = ODEProblem(two_state_logistic_interaction!, [1e4, 8e3], (0.0, 10.0), [true_r, true_K])\n",
     "sol_coculture_untreated = solve(prob_coculture_untreated, Tsit5(), saveat=time_points)\n",
     "coculture_untreated_counts1 = sol_coculture_untreated.u[:,1] .+ 40.0 .* randn(n_timepoints)  # Add noise\n",
     "coculture_untreated_counts2 = sol_coculture_untreated.u[:,2] .+ 40.0 .* randn(n_timepoints)  # Add noise\n",
     "coculture_untreated_counts1 = max.(coculture_untreated_counts1, 100.0)\n",
     "coculture_untreated_counts2 = max.(coculture_untreated_counts2, 100.0)\n",
     "\n",
     "# 4. Coculture Treated (two populations, with drug)\n",
     "exposure_fn_coculture_treated = t -> 0.8  # Constant drug exposure\n",
     "prob_coculture_treated = ODEProblem(two_state_logistic_interaction_death!, [1e4, 8e3], (0.0, 10.0), [true_r, true_K];)\n",
     "sol_coculture_treated = solve(prob_coculture_treated, Tsit5(), saveat=time_points)\n",
     "coculture_treated_counts1 = sol_coculture_treated.u[:,1] .+ 40.0 .* randn(n_timepoints)  # Add noise\n",
     "coculture_treated_counts2 = sol_coculture_treated.u[:,2] .+ 40.0 .* randn(n_timepoints)  # Add noise\n",
     "coculture_treated_counts1 = max.(coculture_treated_counts1, 100.0)\n",
     "coculture_treated_counts2 = max.(coculture_treated_counts2, 100.0)\n",
     "\n",
     "# Create DataFrames for each condition\n",
     "df_mono_untreated = DataFrame(\n",
     "    time = time_points,\n",
     "    count = mono_untreated_counts,\n",
     "    error = fill(10.0, n_timepoints),\n",
     "    dose = fill(0.0, n_timepoints),\n",
     "    cell_line = fill(\"A549\", n_timepoints),\n",
     "    density = fill(1.0, n_timepoints),\n",
     "    replicate = fill(1, n_timepoints),\n",
     "    unit_time = fill(\"h\", n_timepoints),\n",
     "    unit_count = fill(\"count\", n_timepoints),\n",
     "    culture_type = fill(\"monoculture\", n_timepoints),\n",
     "    population_type = fill(\"naive\", n_timepoints)\n",
     ")\n",
     "\n",
     "df_mono_treated = DataFrame(\n",
     "    time = time_points,\n",
     "    count = mono_treated_counts,\n",
     "    error = fill(10.0, n_timepoints),\n",
     "    dose = fill(0.8, n_timepoints),\n",
     "    cell_line = fill(\"A549\", n_timepoints),\n",
     "    density = fill(1.0, n_timepoints),\n",
     "    replicate = fill(1, n_timepoints),\n",
     "    unit_time = fill(\"h\", n_timepoints),\n",
     "    unit_count = fill(\"count\", n_timepoints),\n",
     "    culture_type = fill(\"monoculture\", n_timepoints),\n",
     "    population_type = fill(\"naive\", n_timepoints)\n",
     ")\n",
     "\n",
     "df_coculture_untreated = DataFrame(\n",
     "    time = time_points,\n",
     "    count = coculture_untreated_counts1,  # Track first population\n",
     "    error = fill(10.0, n_timepoints),\n",
     "    dose = fill(0.0, n_timepoints),\n",
     "    cell_line = fill(\"A549\", n_timepoints),\n",
     "    density = fill(1.0, n_timepoints),\n",
     "    replicate = fill(1, n_timepoints),\n",
     "    unit_time = fill(\"h\", n_timepoints),\n",
     "    unit_count = fill(\"count\", n_timepoints),\n",
     "    culture_type = fill(\"coculture\", n_timepoints),\n",
     "    population_type = fill(\"naive\", n_timepoints)\n",
     ")\n",
     "\n",
     "df_coculture_treated = DataFrame(\n",
     "    time = time_points,\n",
     "    count = coculture_treated_counts1,  # Track first population\n",
     "    error = fill(10.0, n_timepoints),\n",
     "    dose = fill(0.8, n_timepoints),\n",
